---
import '../styles/global.css';

const SITE_URL = 'https://gw-display.jasvant-dosanjh.workers.dev';
const DEFAULT_DESCRIPTION =
  'A premium bilingual interactive experience exploring Panj Pyare and Panj Takht — on gurdwara kiosks, phones, and tablets.';
const DEFAULT_OG_IMAGE = `${SITE_URL}/icons/icon-512.svg`;

interface Props {
  title: string;
  description?: string;
  path?: string;
  ogImage?: string;
  breadcrumb?: { name: string; path: string }[];
}

const { title, description = DEFAULT_DESCRIPTION, path = '/', ogImage = DEFAULT_OG_IMAGE, breadcrumb } = Astro.props;
const canonicalUrl = new URL(path, SITE_URL).toString();

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Legacy of the Khalsa',
  url: SITE_URL,
  description: DEFAULT_DESCRIPTION,
};

const breadcrumbJsonLd = breadcrumb
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumb.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, SITE_URL).toString(),
      })),
    }
  : null;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#091322" />
    <meta name="application-name" content="Legacy of the Khalsa" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Legacy of the Khalsa" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#091322" />
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="icons/icon-192.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="icons/icon-192.svg" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="keywords" content="Panj Pyare, Panj Takht, Sikhi, Khalsa, Sikh history, Guru Gobind Singh, interactive display, gurdwara kiosk" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Inter:wght@400;500;600;700;800&family=Mukta+Mahee:wght@400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} is:inline />
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} is:inline />}
  </head>
  <body>
    <slot />
  </body>
</html>
