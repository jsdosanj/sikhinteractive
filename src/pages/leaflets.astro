---
import BaseLayout from '../layouts/BaseLayout.astro';
import KioskShell from '../components/KioskShell.astro';
import displayContent from '../data/display-content';

const content = displayContent;
const breadcrumb = [
  { name: 'Home', path: '/' },
  { name: 'Leaflets', path: '/leaflets' },
];
---

<BaseLayout
  title="Leaflets and Handouts | Legacy of the Khalsa"
  description="Download trusted Sikh learning leaflets to continue your journey after this exhibit."
  path="/leaflets"
  breadcrumb={breadcrumb}
>
  <KioskShell initialView="leaflets">
    <Fragment slot="fallback">
      <h1>{content.leaflets.title.en}</h1>
      <p>{content.leaflets.intro.en}</p>
      <p>
        <a href={content.leaflets.hubUrl} rel="noopener">
          {content.leaflets.cta.en}
        </a>
      </p>
    </Fragment>
  </KioskShell>
</BaseLayout>
