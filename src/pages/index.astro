---
import BaseLayout from '../layouts/BaseLayout.astro';
import KioskShell from '../components/KioskShell.astro';
import displayContent from '../data/display-content';

const content = displayContent;
---

<BaseLayout title="Legacy of the Khalsa — Panj Pyare & Panj Takht" path="/">
  <KioskShell initialView="home">
    <Fragment slot="fallback">
      <h1>{content.home.heroTitle.en}</h1>
      <p>{content.home.heroDescription.en}</p>
      <h2>{content.home.differentiationTitle.en}</h2>
      <p>{content.home.differentiationDescription.en}</p>
      {
        content.home.differentiationCards.map((card) => (
          <article>
            <h2>{card.title.en}</h2>
            <p>{card.description.en}</p>
          </article>
        ))
      }
      <p>
        <a href="/panj-pyare">Explore the Panj Pyare</a> &middot; <a href="/panj-takht">Explore the Panj Takht</a> &middot;{' '}
        <a href="/learn-sikhi">Learn Sikhi</a> &middot; <a href="/timeline">Sikh history timeline</a>
      </p>
    </Fragment>
  </KioskShell>
</BaseLayout>
