---
import BaseLayout from '../layouts/BaseLayout.astro';
import KioskShell from '../components/KioskShell.astro';
import displayContent from '../data/display-content';

const content = displayContent;
const breadcrumb = [
  { name: 'Home', path: '/' },
  { name: 'Quiz', path: '/quiz' },
];
---

<BaseLayout
  title="Sikhi Quiz — Test Your Knowledge | Legacy of the Khalsa"
  description="A three-level interactive quiz on the Panj Pyare, the Panj Takht, the Gurus, and Sikh history — from a first visit to a lifetime in the sangat."
  path="/quiz"
  breadcrumb={breadcrumb}
>
  <KioskShell initialView="quiz">
    <Fragment slot="fallback">
      <h1>{content.sections.quiz.title.en}</h1>
      <p>{content.quiz.intro.en}</p>
      {
        (Object.keys(content.quiz.levelMeta) as (keyof typeof content.quiz.levelMeta)[]).map((level) => (
          <article>
            <h2>{content.quiz.levelMeta[level].title.en}</h2>
            <p>{content.quiz.levelMeta[level].description.en}</p>
          </article>
        ))
      }
    </Fragment>
  </KioskShell>
</BaseLayout>
